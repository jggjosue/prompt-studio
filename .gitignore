# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
lint-output.txt
temp-accordion.txt
*.scratch.*

# dev artifacts (not deployable)
/temp-screenshots/
/.specstory/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
!.env.example
data/landing-readability.json

# firebase
firebase-debug.log
firestore-debug.log

# Precompresión Brotli/Gzip (scripts/precompress-static.mjs, postbuild)
public/**/*.br
public/**/*.gz

# Catálogos comprimidos generados por catalog:build (npm run prebuild).
# No se versionan: prebuild los regenera antes de cualquier deploy.
*.json.gz

# Transcripciones de desarrollo: contienen claves reales. No subir.
/docs/code/

# Un solo fichero de bloqueo: CI usa package-lock.json.
yarn.lock

# Manifiesto de snapshot: se genera por commit y se sube como artifact de CI,
# no se versiona (lo genera npm run snapshot:history).
reports/snapshot/

# Archivo de snapshot empaquetado (npm run snapshot:gate → dist/).
dist/

# Local screenshot/browser captures and their generated dependencies.
/temp-screenshots/

# Local AI/development transcript history; keep durable project docs under docs/.
/.specstory/

# Local AI benchmark artifacts
/.benchmark/

# vinext generated output
/.vinext/
.wrangler/
# Cloudflare local state
.cloudflare/
