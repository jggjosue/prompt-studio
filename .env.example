################################################################
##### PLANTILLA DE VARIABLES DE ENTORNO                    #####
#####                                                      #####
##### NO PONGAS VALORES REALES EN ESTE ARCHIVO.            #####
##### Está versionado en git y se publica con el repo.     #####
##### Copia a `.env.local` y rellena ahí los valores.      #####
################################################################

# AI providers (server-only; never prefix secret keys with NEXT_PUBLIC_)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
# GCP AI workers (non-secret infrastructure identifiers; credentials use Google identity/Secret Manager)
GCP_AI_PROJECT_ID=
GCP_AI_REGION=us-central1
GCP_AI_WORKER_SERVICE=prompt-studio-ai-worker
GCP_AI_QUEUE_INVOKER_SERVICE_ACCOUNT=
GOOGLE_VEO_CREDENTIALS_JSON=
RUNWAY_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
KLING_API_KEY=
LUMA_API_KEY=
PIKA_API_KEY=
HAILUO_API_KEY=
AI_GENERATION_WORKER_URL=
AI_GENERATION_WORKER_TOKEN=
AI_INITIAL_CREDITS=12
DOMAIN=https://www.example.com
DOMAIN_DEV=http://localhost:3046

# CLERK — https://dashboard.clerk.com → API keys
# Opcional si usas dominio Clerk dedicado (ej. clerk.tudominio.com)
NEXT_PUBLIC_CLERK_DOMAIN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=tu_publishable_key_publica
CLERK_SECRET_KEY=tu_clerk_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/prices
NEXT_PUBLIC_CLERK_UNAUTHORIZED_SIGN_IN=/unauthorized
NEXT_PUBLIC_CLERK_USER_PROFILE=/user

# Stripe — Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=tu_stripe_secret
# Stripe Checkout Sessions — Creator ($9/mes · $90/año)
NEXT_PUBLIC_STRIPE_CREATOR_MONTHLY=
NEXT_PUBLIC_STRIPE_CREATOR_ANNUAL=
# Stripe Checkout Sessions — Pro ($19/mes · $190/año)
NEXT_PUBLIC_STRIPE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRO_ANNUAL=
# Stripe Checkout Sessions — Studio ($39/mes · $390/año)
NEXT_PUBLIC_STRIPE_STUDIO_MONTHLY=
NEXT_PUBLIC_STRIPE_STUDIO_ANNUAL=
# MIGRACIÓN: Los antiguos NEXT_PUBLIC_STRIPE_CHECKOUT_MONTHLY/ANNUAL
# corresponden al plan Creator (antes "Premium"). Pueden reutilizarse
# como fallback hasta que se creen los nuevos precios en Stripe.
NEXT_PUBLIC_STRIPE_CHECKOUT_MONTHLY=
NEXT_PUBLIC_STRIPE_CHECKOUT_ANNUAL=
# PRECIOS UNITARIOS
# Mini Web Plan 5 USD
PLAN_PUBLISHABLE_KEY_DEV=tu_publishable_key_publica
NEXT_PUBLIC_STRIPE_CHECKOUT_MINI_WEB_PLAN=
MINI_WEB_PLAN_BUY_BUTTON_ID_DEV=
# Usa el Payment Link Entrepreneur de 10 USD
NEXT_PUBLIC_STRIPE_CHECKOUT_ENTREPRENEUR_PLAN=
ENTREPRENEUR_PLAN_BUY_BUTTON_ID_DEV=
# Usa el Payment Link Professional de 15 USD
NEXT_PUBLIC_STRIPE_CHECKOUT_PROFESSIONAL_PLAN=
PROFESSIONAL_PLAN_BUY_BUTTON_ID_DEV=
# Usa el Payment Link Business de 20 USD
NEXT_PUBLIC_STRIPE_CHECKOUT_BUSINESS_PLAN=
BUSINESS_PLAN_BUY_BUTTON_ID_DEV=
# Usa el Payment Link Premium de 35 USD
NEXT_PUBLIC_STRIPE_CHECKOUT_PREMIUM_PLAN=
PREMIUM_PLAN_BUY_BUTTON_ID_DEV=
# Usa el Payment Link Elite de 50 USD
NEXT_PUBLIC_STRIPE_CHECKOUT_ELITE_PLAN=
ELITE_PLAN_BUY_BUTTON_ID_DEV=
# Corporate Plan 100 USD
NEXT_PUBLIC_STRIPE_CHECKOUT_CORPORATE_PLAN=
CORPORATE_PLAN_BUY_BUTTON_ID=
# Advanced Plan 200 USD
NEXT_PUBLIC_STRIPE_CHECKOUT_ADVANCED_PLAN=
ADVANCED_PLAN_BUY_BUTTON_ID=
# Master Web Plan 500 USD
NEXT_PUBLIC_STRIPE_CHECKOUT_MASTER_WEB_PLAN=
MASTER_WEB_PLAN_BUY_BUTTON_ID=

# Component kits — one Stripe Price ID per kit (one-time payment).
# Add the same keys with real `price_...` values to `.env.local`; never commit
# production values to this example file.
STRIPE_COMPONENT_KIT_SAAS_DASHBOARD_KIT=
STRIPE_COMPONENT_KIT_ECOMMERCE_UI_KIT=
STRIPE_COMPONENT_KIT_RESTAURANT_BOOKING_KIT=
STRIPE_COMPONENT_KIT_PORTFOLIO_CREATOR_KIT=
STRIPE_COMPONENT_KIT_ADMIN_PANEL_KIT=
STRIPE_COMPONENT_KIT_MARKETPLACE_SELLER_KIT=
COMPONENT_KIT_MAX_DOWNLOADS=5

# Cloudflare R2 — bucket (carpeta por proyecto: webpages/{slug}/ o {slug}/)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
# API S3 de R2 (R2 → Overview → Manage R2 API Tokens → Create API token)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional: token de cuenta para GET /api/r2/buckets
CLOUDFLARE_API_TOKEN=

# MongoDB — misma cadena que en `.env`; en `.env.example` la URI no lleva
# credenciales para que el detector de secretos no la marque.
MONGODB_URI=mongodb+srv://<tu-cluster>.mongodb.net/prompt-studio

# Prompt Studio — emails de acceso directo (admin)
PROMPT_STUDIO_CREATOR_JO=admin@example.com
PROMPT_STUDIO_PRO_JO=admin@example.com
PROMPT_STUDIO_STUDIO_JO=admin@example.com
# PROMPT_STUDIO_PREMIUM_JO se conserva como alias administrativo legado.
# MIGRACIÓN: PROMPT_STUDIO_PREMIUM_JO y PROMPT_STUDIO_STARTUP_JO
# se mantienen como alias para no romper accesos existentes.
#
# El menú es un componente de cliente (`useSuperAdmin`), así que el mismo email
# necesita su gemelo NEXT_PUBLIC_*. Sin él el menú funciona, pero Constructor
# visual y Generador de páginas salen deshabilitados con «Coming soon» para
# todos, incluido el admin. Hay que definirlo también en Development, no solo en
# Production, o el acceso se pierde justo en desarrollo.
# NEXT_PUBLIC_PROMPT_STUDIO_PREMIUM_JO=admin@example.com
# Puerta del tramo Pro. Sin poner a 1, publicar en dominio propio y los brand
# kits siguen abiertos a todos, como hasta ahora. Ponerlo a 1 se los quita a los
# usuarios que hoy los usan gratis.
PRO_PLAN_ENFORCED=
# Secreto solo de servidor. Configura una clave distinta y de dominio limitado
# en Development, Preview y Production; nunca uses un nombre NEXT_PUBLIC_*.
RESEND_API_KEY=tu_resend_api_key
LOOPS_API_KEY=
RESEND_EMAIL=hi@example.com
# openssl rand -base64 32 — firma enlaces de confirmación del newsletter.
NEWSLETTER_CONFIRMATION_SECRET=
# Secreto compartido de los cron jobs y de las rutas /api/sync-*.
# Genéralo con: openssl rand -base64 32
CRON_SECRET=
# Despacho inmediato de jobs con Upstash QStash. El kill switch obliga a usar
# solo el cron de recuperación sin perder jobs ya persistidos.
AI_QUEUE_DISPATCH_ENABLED=false
AI_QUEUE_KILL_SWITCH=false
# Opcional: URL pública absoluta del procesador; usa DOMAIN si queda vacía.
AI_QUEUE_PROCESS_URL=
AI_QUEUE_PARALLELISM=3
AI_QUEUE_RATE_PER_MINUTE=30
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
RESEND_AUDIENCE_ID=
CLERK_WEBHOOK_SECRET=tu_webhook_secret
# openssl rand -base64 32
CACHE_ADMIN_TOKEN=
GUEST_DOWNLOAD_SECRET=
PURCHASE_DOWNLOAD_SECRET=
COMPONENT_CATALOG_R2_PREFIX=catalog/components/private

# Content-Security-Policy. Sin definir (o distinto de "true") la CSP sale en
# modo Report-Only: informa a /api/csp-report pero no bloquea nada.
# Ponlo a true cuando los informes lleven días sin violaciones legítimas.
CSP_ENFORCE=

# Rate limiting — opcional. Sin estas dos variables el limitador
# funciona en memoria (por instancia). Con ellas es exacto y distribuido.
# https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase (config pública del cliente)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
MEASUREMENT_ID=
NEXT_PUBLIC_SHOW_ADS=false
