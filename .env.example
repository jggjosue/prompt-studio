# Copia a .env (desarrollo) o configura en Vercel → Environment Variables (producción).
# Nunca subas .env con secretos reales al repositorio.

# --- Clerk (desarrollo: pk_test_* / sk_test_*) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# --- Clerk (producción: solo en Vercel "Production" o .env.production.local) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxx
# CLERK_SECRET_KEY=sk_live_xxxxxxxx
# Opcional: falla el build en Vercel si aún hay pk_test_* (cuando ya deberías usar live)
# CLERK_ENFORCE_LIVE_KEYS=1

# Opcional si usas dominio Clerk dedicado (ej. clerk.tudominio.com)
# NEXT_PUBLIC_CLERK_DOMAIN=clerk.promptstudio.com

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/prices
