# Prompt Studio — files not required by Vercel production builds
# Keep runtime assets under public/ included unless explicitly migrated.

# Local/editor metadata
.DS_Store
.vscode/
.idea/
*.scratch.*
temp-*
lint-output.txt

# Tests and local test output
coverage/
test-results/
playwright-report/
tests/

# Documentation and local reports are not runtime dependencies
docs/
reports/

# Local build/cache output
.next/
out/
build/
dist/
.vercel/
.genkit/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files; production env is managed by Vercel
.env
.env.*
!.env.example

# Generated pre-compression artifacts. Vercel/CDN handles transfer compression.
public/**/*.br
public/**/*.gz
